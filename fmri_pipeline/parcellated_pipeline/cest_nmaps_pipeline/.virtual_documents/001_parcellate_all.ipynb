# Load in fslr annotations
imgs=[]
for (src, desc, space, den) in fslrANNOTATIONS:
    img = datasets.fetch_annotation(source=src, desc=desc,
                                    space=space, den=den)
    imgs.append(img)                

# Transform to 10k space
imgs_10k=[]
for img in imgs:
    img_10k = transforms.fslr_to_fsaverage(img, target_density='10k',
                                           hemi=None,
                                           method='linear')
    imgs_10k.append(img_10k)

# Add 10k annotation(s)
for (src, desc, space, den) in fsaverageANNOTATIONS:
    img_10k = datasets.fetch_annotation(source=src, desc=desc,
                                        space=space, den=den)
    imgs_10k.append(img_10k)


atlas = 'schaefer1000'
scale = 'scale1000_17'

if atlas == 'schaefer1000':
    schaefer = nntdata.fetch_schaefer2018(version='fsaverage5')['1000Parcels17Networks']
    parc_gifti = images.annot_to_gifti(schaefer)
    #print(parc_gifti.shape)
    parc = Parcellater(parc_gifti, 'fsaverage')
    for i in range(len(annots)):
        annot = annots[i]
        img_10k = imgs_10k[i]
        parcellated_img = parc.fit_transform(img_10k, 'fsaverage')
        if annot == 'SAaxis': # Deal with SA axis separately since we have to order the parcels
            order = parcellated_img.argsort()
            parcellated_sa_ranks = order.argsort()
            # Save output as df. Add index numbered 1-1000 called Parcel and df as column, "SAaxis rank"
            sa_df = pd.DataFrame({
                "Parcel": np.arange(1, len(parcellated_sa_ranks) + 1),
                "SAaxis_rank": parcellated_sa_ranks})
            sa_df.to_csv(outpath+'/SAaxis_data_scale1000_17N.csv', index=True, header=True)
        else:
            print(parcellated_img.shape)
            np.savetxt(outpath+annot+'_fsavg_values.csv', parcellated_img, delimiter=',')












